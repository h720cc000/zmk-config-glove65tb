#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 3>;
            key-positions = <49 50>;
        };
    };

    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC         &kp N1        &kp N2        &kp N3                  &kp N4     &kp N5                                            &kp N6            &kp N7  &kp N8  &kp N9  &kp N0  &trans
&kp TAB         &kp Q         &kp L         &kp U                   &kp COMMA  &kp DOT        &trans              &trans         &kp F             &kp W   &kp R   &kp Y   &kp P   &mo 3
&mo 5           &kp E         &kp I         &kp A                   &kp O      &kp MINUS      &kp SLASH           &trans         &kp K             &kp T   &kp N   &kp S   &kp H   &kp RETURN
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C                   &kp V      &kp SEMICOLON  &lt 3 SINGLE_QUOTE  &trans         &kp G             &kp D   &kp M   &kp J   &kp B   &kp RIGHT_SHIFT
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT  &mt LCTRL INT_MUHENKAN  &kp SPACE  &lt 5 SPACE    &kp SPACE           &kp BACKSPACE  &lt 4 INT_HENKAN                          &mo 1   &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp END HOME>;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &bt BT_CLR    &none     &tog 6  &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &ind_con  &none   &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &ind_bat  &none   &none  &none  &none  &none  &none  &none
&none  &none         &none         &none         &none         &none         &none     &none   &none                       &none  &none
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &mo 3
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mo 3   &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp MCLK  &mkp RCLK  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                       &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans             &kp C_PLAY_PAUSE  &trans  &trans    &kp UP    &kp F11    &kp F12  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_UP    &trans            &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &trans            &trans  &trans    &trans    &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans             &trans            &trans                                 &trans   &trans
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        number_layer {
            label = "NUM";
            bindings = <
&none  &none     &none     &none     &none     &none                      &none            &none            &none            &none            &none       &none
&none  &none     &none     &none     &none     &none     &none     &none  &kp KP_PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none       &none
&none  &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC  &kp LBKT  &kp RBKT  &none  &kp KP_MINUS     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp RETURN  &none
&none  &none     &none     &none     &none     &none     &none     &none  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none       &none
&none  &none     &none     &none     &none     &none     &none     &none  &kp RETURN                                                          &none       &none
            >;
        };

        qwerty {
            bindings = <
&trans  &trans  &trans  &trans            &trans  &trans                     &trans  &trans  &trans     &trans   &trans     &kp BACKSPACE
&trans  &kp Q   &kp W   &kp E             &kp R   &kp T   &trans  &none      &kp Y   &kp U   &kp I      &kp O    &kp P      &kp AT
&trans  &kp A   &kp S   &kp D             &kp F   &kp G   &none   &none      &kp H   &kp J   &kp K      &kp L    &kp SEMI   &kp COLON
&trans  &kp Z   &kp X   &kp C             &kp V   &kp B   &none   &kp B      &kp N   &kp M   &kp COMMA  &kp DOT  &kp SLASH  &kp INT_RO
&trans  &trans  &trans  &kp INT_MUHENKAN  &trans  &trans  &trans  &kp SPACE  &trans                              &mo 1      &none
            >;
        };
    };
};
